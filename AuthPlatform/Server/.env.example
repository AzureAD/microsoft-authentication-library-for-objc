# Copy to a local .env file; never commit real values.
DATABASE_URL=postgresql://auth_user:replace-me@127.0.0.1:5432/auth_platform
HOST=127.0.0.1
PORT=8080

# Configure these in a 1Password-managed runtime environment.
JWT_ISSUER=https://auth.example.invalid
JWT_AUDIENCE=auth-platform
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
AUTH_REDIRECT_URI=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
