# Copy to a local .env file; never commit real values.
DATABASE_URL=postgresql://auth_user:replace-me@127.0.0.1:5432/auth_platform
HOST=127.0.0.1
PORT=8080

# Transactional email delivery (Resend)
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_PUBLIC_URL=https://auth.example.com

# Microsoft Entra ID / OpenID Connect
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://auth.example.com/v1/oidc/microsoft/callback

# Sign in with ChatGPT (limited-trial client registration required)
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
# Use "none" for a public client or "client_secret_basic" for a confidential client.
OPENAI_TOKEN_ENDPOINT_AUTH_METHOD=none
OPENAI_REDIRECT_URI=https://auth.example.com/v1/oidc/openai/callback

# WebAuthn relying party configuration
WEBAUTHN_RP_ID=auth.example.com
WEBAUTHN_RP_NAME=AuthPlatform
WEBAUTHN_ORIGIN=https://auth.example.com

# Optional server-to-server OpenAI API credential; not an OIDC client secret.
OPENAI_API_KEY=
