#include "../../../MSAL/xcconfig/msal__common__ios.xcconfig"

CLANG_ENABLE_MODULES = YES
GCC_PREFIX_HEADER =
SWIFT_OBJC_BRIDGING_HEADER =
INFOPLIST_FILE = $(SRCROOT)/Info.plist
GENERATE_INFOPLIST_FILE = YES
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = $(SRCROOT)/MSALMfaSdkSample.entitlements
DEVELOPMENT_TEAM =
PRODUCT_NAME = $(TARGET_NAME)
// Match the captured Authenticator version for this sample's SAS compatibility investigation.
MARKETING_VERSION = 6.8.56
CURRENT_PROJECT_VERSION = 1
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
PRODUCT_BUNDLE_IDENTIFIER = com.microsoft.azureauthenticator
// Authenticator public-client identity for this sample's authorized compatibility investigation.
MSAL_MFA_CLIENT_ID = 4813382a-8fa7-425e-ab75-3b753aab3abb
SKIP_INSTALL = NO
INFOPLIST_KEY_CFBundleDisplayName = MFA Sample
INFOPLIST_KEY_NSCameraUsageDescription = Scan a QR code to add your account.
INFOPLIST_KEY_LSRequiresIPhoneOS = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
